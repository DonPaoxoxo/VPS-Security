# Copy this file to .env in the same directory and fill in real values.
# Never commit the real .env file. No real credentials are in this template.

POSTGRES_USER=ssc
POSTGRES_PASSWORD=change-me-to-a-long-random-value
POSTGRES_DB=ssc

# Used to sign server-side session identifiers. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
# Must be 32+ random characters — the API refuses to start in production
# otherwise (see packages/shared/python/ssc_core/config.py,
# Settings._validate_production_config).
SESSION_SECRET=change-me-to-a-long-random-value

# The HTTPS URL the dashboard and agents will actually reach this API at —
# the dedicated subdomain aaPanel's existing Nginx reverse-proxies to
# 127.0.0.1:18080 on this VPS (see infra/deployment/AAPANEL_REVERSE_PROXY.md).
# NOT http://127.0.0.1:18080 — that's only the loopback address the proxy
# itself talks to, never used externally.
PUBLIC_API_URL=https://security-api.yono777hub.com

# Comma-separated list of the frontend origin(s) allowed to call this API.
# The Vercel hostname isn't known until the frontend is actually deployed —
# leave the placeholder below until then, then update it to the real
# https://<project>.vercel.app (or custom domain) and restart the api
# container (docker compose up -d api). Never leave this as the placeholder
# or as "*" once a real frontend exists.
CORS_ALLOWED_ORIGINS=https://your-dashboard.vercel.app

# Required when the frontend (Vercel) and backend (this VPS) are on
# different domains — the normal case. Leave as "none".
SESSION_COOKIE_SAMESITE=none

# Optional: Telegram bot used for alert delivery. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional: override default retention windows (days).
PERFORMANCE_METRICS_RETENTION_DAYS=90
UPTIME_HISTORY_RETENTION_DAYS=365

# Optional: additional Host headers the API will accept, comma-separated
# (Starlette's TrustedHostMiddleware). PUBLIC_API_URL's own hostname is
# always trusted automatically — you only need this if something else
# (e.g. a health check from a different hostname) also needs to reach it
# directly. Defaults to "localhost,127.0.0.1,testserver".
# TRUSTED_HOSTS=localhost,127.0.0.1,testserver

# Optional: which immediate network peers are trusted to set
# X-Forwarded-For/X-Forwarded-Proto truthfully. Defaults to "*", which is
# safe ONLY because this API's published port is bound to 127.0.0.1 (see
# the `ports:` line in docker-compose.yml) — the only thing that can ever
# connect to it directly is aaPanel's Nginx on this same host. Narrow this
# if that topology ever changes.
# TRUSTED_PROXY_IPS=*
